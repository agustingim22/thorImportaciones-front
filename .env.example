# Copiá los valores a .env (base de datos) y .env.local (el resto).
# Ninguno de los dos se commitea.

# ─── .env (lo usa Prisma y el runtime) ───
# En desarrollo, DATABASE_URL y DIRECT_URL apuntan a la misma base local.
# En producción (Neon/Supabase): DATABASE_URL = string con POOLING, DIRECT_URL = string DIRECTA.
DATABASE_URL="postgresql://usuario:password@localhost:5432/thor?schema=public"
DIRECT_URL="postgresql://usuario:password@localhost:5432/thor?schema=public"

# ─── .env.local (secretos del runtime) ───
# Token del panel de administración (¡en producción usá uno fuerte y distinto!)
ADMIN_TOKEN=un-token-fuerte

# Cloudinary (el SDK lee CLOUDINARY_URL automáticamente)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Mercado Pago: Access Token (TEST-... para pruebas, APP_USR-... en producción)
MERCADOPAGO_ACCESS_TOKEN=

# URL pública del sitio (para las back_urls de Mercado Pago). En producción: https://tu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: URL pública del webhook de MP (producción o túnel ngrok en dev)
MERCADOPAGO_WEBHOOK_URL=

# Resend (emails de confirmación de pedido/pago y recuperación de contraseña).
# Sin dominio verificado en Resend, solo se puede mandar al email de la cuenta.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="Thor Importaciones <pedidos@tu-dominio.com>"

# Upstash Redis (limita intentos de login/registro/pedidos por IP para frenar spam
# y fuerza bruta). Sin estas dos variables, el límite simplemente no se aplica.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meta Pixel (Facebook/Instagram Ads). Sin esta variable, el pixel simplemente no se carga.
NEXT_PUBLIC_META_PIXEL_ID=

# Secreto que usa Vercel Cron para autenticarse contra /api/cron/* (manda
# "Authorization: Bearer $CRON_SECRET" solo). Poné cualquier string largo.
CRON_SECRET=
