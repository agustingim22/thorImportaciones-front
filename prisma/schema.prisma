// Prisma + PostgreSQL — modelo de datos de Thor Importaciones.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexión con pooling (la usa la app)
  directUrl = env("DIRECT_URL")   // conexión directa (la usan las migraciones)
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  team        String
  type        String   // "retro" | "player"
  number      Int
  price       Int      // ARS
  fabric      String
  colorCss    String
  imageUrl    String?
  description String
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Order {
  id            Int          @id @default(autoincrement())
  publicId      String       @unique
  kind          String       @default("Stock") // "Stock" | "Custom"
  status        String       @default("Pending") // Pending | Paid | Cancelled | Delivered
  customerName  String
  customerEmail String
  customerPhone String
  // Dirección de envío estructurada
  street        String // calle y número
  postalCode    String
  city          String
  province      String
  floor         String?
  apartment     String?
  deliveryNotes String? // referencias para el envío (horarios, entre calles, etc.)
  notes         String?
  total         Int
  paymentMethod String? // "MercadoPago" | "Transfer" (solo pedidos de stock)
  paymentId     String?
  receiptUrl    String? // comprobante de transferencia
  createdAt     DateTime     @default(now())
  items         OrderItem[]
  customItems   CustomItem[]
}

model CustomItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference String  // link o descripción de la camiseta
  fabric    String
  size      String
  patch     String?
  number    String?
  name      String?
}

model OrderItem {
  id          Int    @id @default(autoincrement())
  orderId     Int
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  productName String
  unitPrice   Int
  quantity    Int
}
