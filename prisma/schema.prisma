// Prisma + PostgreSQL — modelo de datos de Thor Importaciones.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexión con pooling (la usa la app)
  directUrl = env("DIRECT_URL")   // conexión directa (la usan las migraciones)
}

model Product {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  team          String
  type          String // "retro" | "fan" | "player"
  price         Int // ARS
  colorCss      String
  images        String[] @default([]) // hasta 3 fotos (la primera es la portada)
  description   String
  stock         Int      @default(0) // unidades disponibles (0 = sin stock)
  presetName    String? // nombre ya definido por el admin (si está, el comprador no elige)
  presetNumber  String? // número ya definido por el admin (si está, el comprador no elige)
  createdAt     DateTime @default(now())
  patches       Patch[]
}

/// Opción de parche que el comprador puede elegir para un producto (con su propio precio extra).
model Patch {
  id         Int     @id @default(autoincrement())
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  imageUrl   String
  extraPrice Int     @default(0) // ARS, se suma al precio de la camiseta
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  street       String?
  postalCode   String?
  city         String?
  province     String?
  floor        String?
  apartment    String?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  passwordResets PasswordReset[]
  orders       Order[]
}

model Session {
  id        String   @id @default(cuid()) // token opaco, va en la cookie
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid()) // token opaco, va en el link del email
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // válido por 1 hora
  usedAt    DateTime? // se marca al usarse, para que el link no sirva dos veces
  createdAt DateTime  @default(now())
}

model Order {
  id            Int          @id @default(autoincrement())
  publicId      String       @unique
  kind          String       @default("Stock") // "Stock" | "Custom"
  status        String       @default("Pending") // Pending | Paid | Cancelled | Delivered
  userId        Int? // si el comprador estaba logueado al pagar
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String
  customerPhone String
  // Dirección de envío estructurada
  street        String // calle y número
  postalCode    String
  city          String
  province      String
  floor         String?
  apartment     String?
  deliveryNotes String? // referencias para el envío (horarios, entre calles, etc.)
  notes         String?
  total         Int
  paymentMethod String? // "MercadoPago" | "Transfer" (solo pedidos de stock)
  paymentId     String?
  receiptUrl    String? // comprobante de transferencia
  createdAt     DateTime     @default(now())
  items         OrderItem[]
  customItems   CustomItem[]
}

model CustomItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference String  // link o descripción de la camiseta
  fabric    String
  size      String
  patch     String?
  number    String?
  name      String?
}

/// Testimonio de un comprador (cargado a mano por el admin), mostrado en la home.
model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  comment   String
  rating    Int      @default(5) // 1 a 5
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model OrderItem {
  id              Int    @id @default(autoincrement())
  orderId         Int
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  productName     String
  unitPrice       Int // precio final: base del producto + extra del parche elegido
  quantity        Int
  customName      String? // nombre elegido por el comprador (o el preset del producto)
  customNumber    String? // número elegido por el comprador (o el preset del producto)
  patchLabel      String? // snapshot del parche elegido, si eligió alguno
  patchExtraPrice Int? // snapshot del precio extra del parche elegido
}
