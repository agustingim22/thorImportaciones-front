// Prisma + PostgreSQL — modelo de datos de Thor Importaciones.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexión con pooling (la usa la app)
  directUrl = env("DIRECT_URL") // conexión directa (la usan las migraciones)
}

model Product {
  id                 Int                 @id @default(autoincrement())
  slug               String              @unique
  team               String
  type               String // "retro" | "fan" | "player"
  price              Int // ARS, precio de lista
  salePrice          Int? // ARS, si está seteado (y es menor a price) se muestra como oferta
  colorCss           String
  images             String[]            @default([]) // hasta 3 fotos (la primera es la portada)
  description        String
  stock              Int                 @default(0) // unidades disponibles (0 = sin stock)
  presetName         String? // nombre ya definido por el admin (si está, el comprador no elige)
  presetNumber       String? // número ya definido por el admin (si está, el comprador no elige)
  sizes              String[]            @default(["S", "M", "L", "XL", "XXL"]) // talles disponibles para esta camiseta
  createdAt          DateTime            @default(now())
  patches            Patch[]
  sizeStocks         ProductSize[]
  reviews            Review[]
  stockNotifications StockNotification[]
  questions          ProductQuestion[]
  favoriteWatches    FavoriteWatch[]
}

/// Pregunta pública de un visitante sobre un producto puntual. Queda oculta hasta que
/// el admin la responde — responder ES publicarla (no hay un toggle aparte).
model ProductQuestion {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Email de alguien que pidió que le avisen cuando un producto vuelva a tener stock.
model StockNotification {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, email])
}

/// Aviso de stock bajo/agotado para un favorito (email + producto, sin necesitar
/// cuenta). `notifiedAt` marca la última vez que se avisó por la caída actual de
/// stock; se resetea a null cuando el stock vuelve a superar el umbral bajo, para
/// poder avisar de nuevo si vuelve a caer más adelante.
model FavoriteWatch {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([productId, email])
}

/// Reseña de un comprador sobre un producto puntual. Queda oculta (`published=false`)
/// hasta que el admin la aprueba, para evitar spam visible en la web.
model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int      @default(5) // 1 a 5
  comment   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Stock disponible de un producto, desglosado por talle. `Product.stock` se mantiene
/// como la suma de estas filas (para no tocar todo lo que ya lee ese campo agregado).
model ProductSize {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int     @default(0)

  @@unique([productId, size])
}

/// Opción de parche que el comprador puede elegir para un producto (con su propio precio extra).
model Patch {
  id         Int     @id @default(autoincrement())
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  imageUrl   String
  extraPrice Int     @default(0) // ARS, se suma al precio de la camiseta
}

model User {
  id                 Int             @id @default(autoincrement())
  email              String          @unique
  passwordHash       String
  name               String
  phone              String?
  street             String?
  postalCode         String?
  city               String?
  province           String?
  floor              String?
  apartment          String?
  createdAt          DateTime        @default(now())
  cartReminderSentAt DateTime? // se resetea a null cada vez que el carrito cambia
  sessions           Session[]
  passwordResets     PasswordReset[]
  orders             Order[]
  savedCartItems     SavedCartItem[]
}

model Session {
  id        String   @id @default(cuid()) // token opaco, va en la cookie
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid()) // token opaco, va en el link del email
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // válido por 1 hora
  usedAt    DateTime? // se marca al usarse, para que el link no sirva dos veces
  createdAt DateTime  @default(now())
}

model Order {
  id                  Int          @id @default(autoincrement())
  publicId            String       @unique
  kind                String       @default("Stock") // "Stock" | "Custom"
  status              String       @default("Pending") // Pending | Paid | Cancelled | Delivered
  userId              Int? // si el comprador estaba logueado al pagar
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName        String
  customerEmail       String
  customerPhone       String
  // Dirección de envío estructurada
  street              String // calle y número
  postalCode          String
  city                String
  province            String
  floor               String?
  apartment           String?
  deliveryNotes       String? // referencias para el envío (horarios, entre calles, etc.)
  notes               String?
  total               Int
  shippingCost        Int          @default(0) // snapshot de lo cobrado por envío en este pedido
  couponCode          String? // snapshot del código aplicado (si borran el cupón, el pedido conserva el dato)
  discountAmount      Int          @default(0) // ARS descontados del subtotal por el cupón
  paymentMethod       String? // "MercadoPago" | "Transfer" (solo pedidos de stock)
  paymentId           String?
  receiptUrl          String? // comprobante de transferencia
  trackingNumber      String? // código de seguimiento del correo, cargado por el admin al despachar
  deliveredAt         DateTime? // se marca la primera vez que el status pasa a "Delivered"
  reviewRequestSentAt DateTime? // cuándo se mandó el mail pidiendo reseña (null = todavía no)
  isGift              Boolean      @default(false) // el remito impreso oculta el precio si es true
  giftMessage         String? // nota tipo "De parte de..." para incluir en el paquete
  createdAt           DateTime     @default(now())
  items               OrderItem[]
  customItems         CustomItem[]
}

model CustomItem {
  id                Int     @id @default(autoincrement())
  orderId           Int
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference         String // link o descripción de la camiseta
  referenceImageUrl String? // foto de referencia subida por el comprador
  fabric            String
  size              String
  patch             String?
  number            String?
  name              String?
}

/// Foto del carrusel de la portada (cargada a mano por el admin).
model HeroImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  position  Int      @default(0) // orden de aparición en el carrusel
  createdAt DateTime @default(now())
}

/// Testimonio de un comprador (cargado a mano por el admin), mostrado en la home.
model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  comment   String
  rating    Int      @default(5) // 1 a 5
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Email de un visitante interesado (footer), para futuras promos por mail.
model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Configuración de envío (fila única, id=1), editable desde el admin.
model ShippingSettings {
  id                    Int  @id @default(1)
  flatCost              Int  @default(0) // ARS, se suma al total de pedidos de catálogo
  freeShippingThreshold Int? // si el subtotal de productos llega a este monto, el envío es gratis
}

/// Carrito de un usuario logueado, para que persista entre dispositivos. Sin relación a
/// Product/Patch (igual que OrderItem) para no romper si el producto se borra después.
model SavedCartItem {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    Int
  qty          Int
  size         String
  customName   String?
  customNumber String?
  patchId      Int?
  createdAt    DateTime @default(now()) // se recrea entera cada sync, sirve como "última vez tocado"
}

/// Post de Instagram elegido a mano por el admin (link pegado, sin token/API) para
/// mostrar como prueba social en la home.
model InstagramPost {
  id        Int      @id @default(autoincrement())
  url       String
  createdAt DateTime @default(now())
}

/// Configuración del pop-up de newsletter con cupón de bienvenida (fila única, id=1).
model NewsletterPopupSettings {
  id         Int     @id @default(1)
  enabled    Boolean @default(false)
  couponCode String? // código de un Coupon existente (se gestiona en la pestaña Cupones)
  headline   String  @default("Sumate y conseguí un cupón de descuento")
  subtext    String  @default("Enterate primero de nuevas camisetas, drops y promos exclusivas.")
}

/// Cupón de descuento que el comprador puede aplicar en el carrito.
model Coupon {
  id            Int       @id @default(autoincrement())
  code          String    @unique // siempre en MAYÚSCULAS
  type          String // "percentage" | "fixed"
  value         Int // porcentaje (1-100) o monto fijo en ARS, según `type`
  active        Boolean   @default(true)
  expiresAt     DateTime?
  maxUses       Int? // null = sin límite
  usedCount     Int       @default(0)
  minOrderValue Int? // null = sin mínimo de compra
  createdAt     DateTime  @default(now())
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  productName     String
  unitPrice       Int // precio final: base del producto + extra del parche elegido
  quantity        Int
  size            String? // talle elegido por el comprador (S/M/L/XL/XXL/XXXL/XXXXL)
  customName      String? // nombre elegido por el comprador (o el preset del producto)
  customNumber    String? // número elegido por el comprador (o el preset del producto)
  patchLabel      String? // snapshot del parche elegido, si eligió alguno
  patchExtraPrice Int? // snapshot del precio extra del parche elegido
}
